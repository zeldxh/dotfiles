#!/usr/bin/env python3
"""pinned-app N: focus (or launch) the Nth app pinned in the Cinnamon taskbar."""
import json, os, re, subprocess, sys

n = int(sys.argv[1])
home = os.path.expanduser('~')
cfg = json.load(open(f'{home}/.config/cinnamon/spices/grouped-window-list@cinnamon.org/2.json'))
pinned = cfg['pinned-apps']['value']
if n < 1 or n > len(pinned):
    sys.exit(0)
desktop_id = pinned[n - 1]

path = None
for d in (f'{home}/.local/share/applications', '/usr/share/applications', '/var/lib/flatpak/exports/share/applications'):
    if os.path.exists(f'{d}/{desktop_id}'):
        path = f'{d}/{desktop_id}'
        break

tokens = set()
if path:
    text = open(path).read()
    m = re.search(r'^StartupWMClass=(.+)$', text, re.M)
    if m:
        tokens.add(m.group(1).strip().lower())
    m = re.search(r'^Exec=(\S+)', text, re.M)
    if m:
        tokens.add(os.path.basename(m.group(1)).lower())
tokens.add(desktop_id.removesuffix('.desktop').lower())

out = subprocess.run(['wmctrl', '-lx'], capture_output=True, text=True).stdout
wins = []
for line in out.splitlines():
    parts = line.split(None, 4)
    if len(parts) < 3:
        continue
    wid, desk, wclass = parts[0], parts[1], parts[2].lower()
    if desk == '-1' or 'nemo-desktop' in wclass:
        continue
    if any(t == p or t in p for t in tokens for p in wclass.split('.')) or any(t in wclass for t in tokens if len(t) > 3):
        wins.append(wid)

active = subprocess.run(['xprop', '-root', '_NET_ACTIVE_WINDOW'], capture_output=True, text=True).stdout.split()[-1]
active = '0x%08x' % int(active, 16)

if wins:
    # cycle through the app's windows if one is already focused
    target = wins[0]
    if active in wins:
        target = wins[(wins.index(active) + 1) % len(wins)]
    subprocess.run(['wmctrl', '-i', '-a', target])
else:
    subprocess.Popen(['gtk-launch', desktop_id.removesuffix('.desktop')], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
