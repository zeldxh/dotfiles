[user]
	name = Zel
	email = 783613+zeldxh@users.noreply.github.com
	signingkey = ~/.ssh/id_ed25519_github.pub

[init]
	defaultBranch = main

[core]
	editor = code --wait
	autocrlf = input

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[rebase]
	autoStash = true

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers

[commit]
	gpgsign = true

[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
